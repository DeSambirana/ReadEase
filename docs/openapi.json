  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "important_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Important Terms"
          },
          "text": {
            "type": "string",
            "maxLength": 30000,
            "minLength": 1,
            "title": "Text"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "title": "Title",
            "default": "Materi tanpa judul"
          },
          "options": {
            "$ref": "#/components/schemas/Options"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "cards": {
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "type": "array",
            "title": "Cards"
          },
          "exercises": {
            "items": {
              "$ref": "#/components/schemas/Exercise"
            },
            "type": "array",
            "title": "Exercises"
          },
          "summary": {
            "$ref": "#/components/schemas/ReviewSummary"
          },
          "important_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Important Terms"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/Decision"
            },
            "type": "array",
            "title": "Decisions"
          },
          "proposals": {
            "items": {
              "$ref": "#/components/schemas/Proposal"
            },
            "type": "array",
            "title": "Proposals"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "is_example": {
            "type": "boolean",
            "title": "Is Example",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document",
          "cards"
        ],
        "title": "AnalyzeResponse"
      },
      "Assignment": {
        "properties": {
          "student_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Student Id"
          },
          "workspace": {
            "$ref": "#/components/schemas/PdfRequest"
          },
          "reviewed": {
            "type": "boolean",
            "title": "Reviewed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "workspace",
          "reviewed"
        ],
        "title": "Assignment"
      },
      "Card": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_sentence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Source Sentence Ids"
          },
          "adapted_text": {
            "type": "string",
            "title": "Adapted Text"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "review_status": {
            "$ref": "#/components/schemas/ReviewStatus",
            "default": "flagged"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "flagged_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flagged Terms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "source_sentence_ids",
          "adapted_text"
        ],
        "title": "Card"
      },
      "CodeEntry": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CodeEntry"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "Guru"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "Decision": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "title": "Proposal Id"
          },
          "status": {
            "$ref": "#/components/schemas/ReviewStatus"
          },
          "edited_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30000
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "proposal_id",
          "status"
        ],
        "title": "Decision"
      },
      "Document": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "title": "Title"
          },
          "sentences": {
            "items": {
              "$ref": "#/components/schemas/Sentence"
            },
            "type": "array",
            "title": "Sentences"
          },
          "metrics_before": {
            "$ref": "#/components/schemas/Metrics"
          },
          "metrics_after": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Metrics"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "sentences",
          "metrics_before"
        ],
        "title": "Document"
      },
      "Exercise": {
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End"
          },
          "reviewed": {
            "type": "boolean",
            "title": "Reviewed",
            "default": false
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_sentence_id": {
            "type": "string",
            "title": "Source Sentence Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "blank_text": {
            "type": "string",
            "title": "Blank Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "id",
          "source_sentence_id",
          "answer",
          "blank_text"
        ],
        "title": "Exercise"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "stage": {
            "type": "integer",
            "title": "Stage",
            "default": 6
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "HealthResponse"
      },
      "KeywordCandidate": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_sentence_id": {
            "type": "string",
            "title": "Source Sentence Id"
          },
          "keyword": {
            "type": "string",
            "title": "Keyword"
          },
          "start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "End"
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Occurrence"
          },
          "part_of_speech": {
            "type": "string",
            "title": "Part Of Speech"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "source_sentence_id",
          "keyword",
          "start",
          "end",
          "occurrence",
          "part_of_speech"
        ],
        "title": "KeywordCandidate"
      },
      "KeywordSelection": {
        "properties": {
          "start": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "source_sentence_id": {
            "type": "string",
            "title": "Source Sentence Id"
          },
          "keyword": {
            "type": "string",
            "minLength": 1,
            "title": "Keyword"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_sentence_id",
          "keyword"
        ],
        "title": "KeywordSelection"
      },
      "Metrics": {
        "properties": {
          "avg_words_per_sentence": {
            "type": "number",
            "minimum": 0.0,
            "title": "Avg Words Per Sentence"
          },
          "sentences_over_threshold": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sentences Over Threshold"
          },
          "threshold": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Threshold",
            "default": 20
          },
          "words_per_block": {
            "items": {
              "type": "integer"
